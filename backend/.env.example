# Copy to .env and fill in. See backend/README.md for the full explanation
# of each OCR-provider-specific block.

PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/billsplitter
TEST_DATABASE_URL=postgres://user:password@localhost:5432/billsplitter_test
JWT_SECRET=some-long-random-string

# Comma-separated list of origins allowed to call this API (e.g. your
# deployed frontend + custom domain). Leave unset for local dev - CORS is
# wide open by default so `npm run dev` on the frontend just works.
# CORS_ORIGIN=https://yourdomain.com,https://your-app.vercel.app

# --- Receipt OCR provider (see backend/README.md) ---
OCR_PROVIDER=documentai
DOCAI_PROJECT_ID=
DOCAI_PROCESSOR_ID=
DOCAI_LOCATION=us
# Path to a GCP service account JSON key file with Document AI access.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/your-key.json

# --- Cloudinary (permanent storage for uploaded receipt photos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
